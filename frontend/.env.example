# ==========================================
# RentFair AI - Environment Configuration Template
# Duplicate this file as .env and fill in your values
# ==========================================

# Server Configuration
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development

# Optional AI / LLM Enhancer (Direct Google Gemini API)
# The system includes an embedded deterministic legal NLP engine,
# but providing a Gemini key activates real-time generative counter-negotiation.
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000

# Supabase Production Database (PostgreSQL)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
